<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.4.1</Version>
    <Author>Solterax</Author>
    <RepoUrl>https://github.com/Solterax/GearScout</RepoUrl>
    <Name>GearScout</Name>
    <Punchline>Track your XIVGear sets for your current job.</Punchline>
    <Description>Import XIVGear sets, check gear and materia, and highlight wanted missing loot. Includes live equipped gear, bags and Armoury Chest plus locally saved checks of retainers, the glamour dresser and armoire.</Description>
    <Tags>gear;xivgear;inventory</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
