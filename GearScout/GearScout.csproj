<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.11.1</Version>
    <Author>Solterax</Author>
    <RepoUrl>https://github.com/Solterax/GearScout</RepoUrl>
    <Name>GearScout</Name>
    <Punchline>Track your XIVGear sets for your current job.</Punchline>
    <Description>Build gear sets in game with slot and job filtered item search, or import XIVGear links. Check gear, materia and saved storage ownership, and highlight wanted missing loot.</Description>
    <Tags>gear;xivgear;inventory</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
