<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Author>Solterax</Author>
    <RepoUrl>https://github.com/Solterax/GearScout</RepoUrl>
    <Name>GearScout</Name>
    <Punchline>Track your XIVGear sets for your current job.</Punchline>
    <Description>Import XIVGear links and compare gear and melded materia against equipped items, bags, and Armoury Chest. Only sets for the current job are displayed.</Description>
    <Tags>gear;xivgear;inventory</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
