<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DalamudPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)</DalamudPath>
    <DalamudPath Condition="'$(DalamudPath)' == ''">$(AppData)/XIVLauncher/addon/Hooks/dev</DalamudPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GearScout/LootNameFormatting.cs" Link="LootNameFormatting.cs" />
    <Reference Include="Dalamud"><HintPath>$(DalamudPath)/Dalamud.dll</HintPath></Reference>
    <Reference Include="Lumina"><HintPath>$(DalamudPath)/Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudPath)/Lumina.Excel.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DalamudPath)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
